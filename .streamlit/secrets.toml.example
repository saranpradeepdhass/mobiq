# Copy to .streamlit/secrets.toml (git-ignored) or set the equivalent in your host's secrets UI.
# NEVER commit real values.

[gsheets]
spreadsheet_id = "YOUR_SPREADSHEET_ID"   # the long id in the sheet URL
cache_ttl_seconds = 30

# Fields copied from the service-account JSON key file.
[gsheets.service_account]
type = "service_account"
project_id = "your-project"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "mobiq@your-project.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"

[auth]
# Random string, 32+ chars (python -c "import secrets;print(secrets.token_urlsafe(32))"). Used to HMAC codes.
secret = "CHANGE-ME-TO-A-LONG-RANDOM-STRING"
# Creates the first admin on first sign-in, only while no admin exists in the Users sheet.
bootstrap_admin_email = "you@example.com"
# Admin accounts must also enter this 4-digit PIN to sign in. Shared by all admins. Quote it. Avoid easy PINs
# (0000, 1234 ...). If it is missing, admins cannot sign in; if it is not 4 digits the app refuses to start.
admin_pin = "CHANGE-ME"
# true: a new email is asked for a mobile number and gets an account (role "user") with one line for that number.
# false: only people an admin has invited can sign in.
allow_registration = true
session_hours = 8
code_ttl_seconds = 600
# false (default): sign in with the email address alone - NO proof of mailbox ownership, so anyone who knows an
# active user's email (including an admin's) can sign in as them. true: emailed one-time code (needs [smtp]).
require_code = false
# DEVELOPMENT ONLY (only with require_code = true): show the sign-in code on screen instead of emailing it. Never enable in production.
dev_show_code = false

[smtp]
# Gmail / Google Workspace. Needs 2-Step Verification on the account, then an App Password
# (https://myaccount.google.com/apppasswords). Your normal Google password will NOT work.
host = "smtp.gmail.com"
port = 587                                    # STARTTLS. Alternative: port = 465 with use_ssl = true
username = "your.address@gmail.com"
password = "xxxx xxxx xxxx xxxx"              # the 16-character app password, not your login password
sender = "Mobiq <your.address@gmail.com>"     # Gmail rewrites the From address to the account's own
use_ssl = false
